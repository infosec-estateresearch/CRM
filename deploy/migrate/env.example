# crm-migrate runtime configuration: NAMES ONLY, never values.
# The real file is /srv/CRM/runtime/migrate/env (root:root, 0600), written by
#   scripts/migrate.sh credentials
# CRM_SF_ORIGIN is https://<mydomain>.my.salesforce.com (or <mydomain>.sandbox.my.salesforce.com).
# CRM_SF_API_VERSION is NN.N, the REST API version confirmed at L1.
CRM_SF_ORIGIN=
CRM_SF_CLIENT_ID=
CRM_SF_CLIENT_SECRET=
CRM_SF_API_VERSION=
