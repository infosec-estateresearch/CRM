# crm-migrate runtime configuration for --auth soap-legacy (CRM-002-S, TEMPORARY): NAMES ONLY.
# The real file is /srv/CRM/runtime/migrate/env (root:root, 0600). In this mode it holds only
# these two names; the username and password are never stored here (stdin only).
CRM_SF_ORIGIN=
CRM_SF_API_VERSION=
