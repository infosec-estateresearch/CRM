# crm-migrate runtime configuration for --auth soap-legacy (CRM-002-S, TEMPORARY): NAMES ONLY.
# The real file is /srv/CRM/runtime/migrate/env (root:root, 0600). In this mode it holds only
# these three names; the username and password are never stored here (stdin only).
# CRM_LEGACY_ENV_FILE is the absolute path of the existing ELT env file holding
# NIF_SRC_SALESFORCE_USER / NIF_SRC_SALESFORCE_PASS (root-owned regular file, not group- or
# world-writable, no symlinked component). Empty: the legacy commands refuse (not configured).
CRM_SF_ORIGIN=
CRM_SF_API_VERSION=
CRM_LEGACY_ENV_FILE=
