# Variable NAMES only for the crm-dev Compose project (deploy/compose.json).
# The real file is /srv/CRM/runtime/dev/env (root-owned, mode 0600, outside Git).
# Generate every secret on the host; never commit a value here.
# Compose refuses to start if any of these is unset.

# Bind-mount sources: absolute directories under /srv/CRM/runtime/dev that
# exist before the first start (docs/BUILD.md section 7.1). The three EspoCRM
# directories are mounted read-write on crm-app and crm-daemon.
CRM_DB_DIR=
# -> /var/www/html/data
CRM_DATA_DIR=
# -> /var/www/html/custom (filled from Git by scripts/deploy_custom.sh)
CRM_CUSTOM_DIR=
# -> /var/www/html/client/custom
CRM_CLIENT_CUSTOM_DIR=

# MariaDB
CRM_DB_NAME=
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_ROOT_PASSWORD=

# EspoCRM first-run administrator and site URL.
# CRM_SITE_URL is http://<CRM_BIND_IP>:8180. The entrypoint applies it only at
# installation; on an existing install change it with config:set (docs/BUILD.md §7.6).
CRM_ADMIN_USERNAME=
CRM_ADMIN_PASSWORD=
CRM_SITE_URL=

# LAN access (CRM-D019, docs/BUILD.md §7.6). Real values live only in the
# runtime env file; never commit an address. Check with
# `python3 scripts/check_access.py dev` before every `up`.
# CRM_BIND_IP: the one host LAN IPv4 address crm-app publishes 8180 on
# (never 0.0.0.0, never loopback).
CRM_BIND_IP=
# CRM_ALLOWED_SOURCES: space-separated private (RFC 1918) IPv4 CIDRs, each /16
# or longer, that Apache in crm-app admits (deploy/apache/crm-access.conf).
CRM_ALLOWED_SOURCES=
