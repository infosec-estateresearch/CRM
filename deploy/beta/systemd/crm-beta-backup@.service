# CRM-007: nightly crm-beta backup. TEMPLATE in Git; installed only by the
# operator, with PO consent (docs/BETA.md, "Backup timer"). The instance name is
# the 12-hex short commit of the deployed release, so the unit runs the
# root-owned, read-only scripts unpacked by deploy_release.sh:
#   systemctl enable --now crm-beta-backup@<short>.timer
[Unit]
Description=crm-beta backup (release %i)
Documentation=file:///srv/CRM/deploy/%i/docs/BETA.md
ConditionPathIsDirectory=/srv/CRM/deploy/%i/scripts
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# No beta env-file name may be set here: backup.sh refuses to run if one is.
ExecStart=/usr/bin/bash /srv/CRM/deploy/%i/scripts/backup.sh beta
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
