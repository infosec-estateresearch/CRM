# Variable NAMES only for the crm-beta Compose project (deploy/beta/compose.json).
# The real file is /srv/CRM/runtime/beta/env (root-owned, mode 0600, outside Git).
# Generate every secret on the host; never commit a value here. Example
# placeholder values are in docs/BETA.md (documentation addresses only).
# Never export any name in this file in the shell: the scripts refuse to run.

# Bind-mount sources: exactly /srv/CRM/runtime/beta/{db,data,custom,client/custom}.
CRM_DB_DIR=
CRM_DATA_DIR=
CRM_CUSTOM_DIR=
CRM_CLIENT_CUSTOM_DIR=

# MariaDB
CRM_DB_NAME=
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_ROOT_PASSWORD=

# EspoCRM first-run administrator and site URL. CRM_SITE_URL is exactly
# https://<CRM_BETA_HOSTNAME>; deploy_release.sh also sets it with config:set.
CRM_ADMIN_USERNAME=
CRM_ADMIN_PASSWORD=
CRM_SITE_URL=

# Edge (crm-beta-edge, HAProxy on the host network), validated fail-closed by
# `scripts/check_access.py beta` and rendered into
# /srv/CRM/runtime/beta/edge/haproxy.cfg:
# CRM_BETA_BIND_IP: the one RFC 1918 host address the edge listens on (never 0.0.0.0).
CRM_BETA_BIND_IP=
# CRM_BETA_PORT: the edge port, 1024-65535 (unprivileged, so no capability is added).
CRM_BETA_PORT=
# CRM_BETA_UPSTREAM_SOURCES: 1-4 space-separated RFC 1918 /32s (the PO's HAProxy).
CRM_BETA_UPSTREAM_SOURCES=
# CRM_BETA_HOSTNAME: the public DNS name the PO's HAProxy serves over TLS.
CRM_BETA_HOSTNAME=
# CRM_BETA_APP_PORT: the loopback port crm-app publishes (127.0.0.1 only), 1024-65535.
CRM_BETA_APP_PORT=
