{
    "fields": {
        "account": {
            "audited": true
        },
        "emailAddress": {
            "audited": true
        },
        "title": {
            "maxLength": 255
        },
        "opportunityRole": {
            "options": ["", "Business User", "Decision Maker", "Economic Buyer", "Economic Decision Maker", "Evaluator", "Executive Sponsor", "Influencer", "Technical Buyer", "Other"]
        },
        "identityStatus": {
            "type": "enum",
            "options": ["active", "retired", "superseded"],
            "default": "active",
            "isSorted": false,
            "isCustom": true
        },
        "successor": {
            "type": "link",
            "isCustom": true
        },
        "predecessors": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "noLoad": true,
            "importDisabled": true,
            "isCustom": true
        },
        "sfId": {
            "type": "varchar",
            "maxLength": 18,
            "readOnlyAfterCreate": true,
            "audited": false,
            "isCustom": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "sfOwnerId": {
            "type": "varchar",
            "maxLength": 18,
            "audited": false,
            "isCustom": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "sfCreatedAt": {
            "type": "datetime",
            "audited": false,
            "isCustom": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        }
    },
    "links": {
        "successor": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "predecessors",
            "isCustom": true
        },
        "predecessors": {
            "type": "hasMany",
            "entity": "Contact",
            "foreign": "successor",
            "isCustom": true
        }
    },
    "collection": {
        "textFilterFields": ["name", "emailAddress", "phoneNumber"]
    },
    "indexes": {
        "sfId": {
            "type": "unique",
            "columns": ["sfId"]
        }
    }
}
